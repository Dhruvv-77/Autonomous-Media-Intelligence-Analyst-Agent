# ==============================================================================
# Autonomous Media Intelligence Analyst Agent — Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure your preferred provider.
# NEVER commit your actual .env file or API keys to version control.

# Option 1: Groq Cloud (Recommended: lightning-fast parallel inference)
# Obtain a free key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Option 2: Google Gemini Developer API
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Option 3: Deterministic Simulation (No API key required)
# If no keys are provided, the system defaults to deterministic offline simulation.
