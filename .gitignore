# ==============================================================================
# Autonomous Media Intelligence Analyst Agent — .gitignore
# ==============================================================================

# Python Virtual Environments & Bytecode
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
eggs/
.eggs/
parts/
var/
sdist/
*.egg-info/
.installed.cfg
*.egg

# Testing, Linting & Coverage
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/

# Local Secrets & Configuration (Never commit secrets!)
.env
.env.*
.env.local
!.env.example

# Local SQLite Databases & State
*.db
*.sqlite
*.sqlite3

# Local Pipeline Output Runs (Exclude local author data; keep outputs dir)
outputs/*
!outputs/.gitkeep

# Confidential Assessment Documents & Private Data
Assessment Autonomous Media Intelligence Analyst Agent.pdf
*.pdf
data/official/*
data/private/*

# Frontend Build & Node Modules
frontend/node_modules/
node_modules/
frontend/dist/
.eslintcache

# OS-Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.tmp
*.temp

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*~
